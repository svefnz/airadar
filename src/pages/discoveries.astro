---
import SiteLayout from '../layouts/SiteLayout.astro';
import { loadRadar } from "../lib/data/load";
import { Badge } from '../components/ui/badge';
import { badgeTone } from '../lib/utils/badgeTone';
import { PlatformRow } from '../features/PlatformRow';

const data = loadRadar();
const now = Date.now();
const day = 86_400_000;

const withOffers = new Set(data.offers.map((o) => o.platformId));
const activeOffers = new Set(data.offers.filter((o) => o.status === 'active').map((o) => o.platformId));

const discovered = data.platforms
  .filter((p) => now - Date.parse(p.firstDiscoveredAt) <= 30 * day)
  .sort((a, b) => Date.parse(b.firstDiscoveredAt) - Date.parse(a.firstDiscoveredAt));

const last7 = discovered.filter((p) => now - Date.parse(p.firstDiscoveredAt) <= 7 * day);
const last30 = discovered.filter((p) => now - Date.parse(p.firstDiscoveredAt) > 7 * day);
---

<SiteLayout title="新平台发现" description="最近 7–30 天发现的新 AI 平台">
  <div class="mb-5 flex flex-wrap items-end justify-between gap-2">
    <div>
      <h1 class="text-xl font-bold">新平台发现</h1>
      <p class="mt-1 text-xs text-muted-foreground">
        最近 30 天主动发现的新平台 · 共 {discovered.length} 个
        <span class="ml-1 text-muted-foreground">（“发现时间” ≠ “官方发布日期”，分别记录）</span>
      </p>
    </div>
  </div>

  <section class="space-y-3">
    <h2 class="text-sm font-semibold text-foreground flex items-center gap-2">
      最近 7 天 <Badge variant="outline" className={badgeTone('accent')}>{last7.length}</Badge>
    </h2>
    {last7.length === 0 ? (
      <p class="text-xs text-muted-foreground py-4">最近 7 天未发现新平台</p>
    ) : (
      <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
        {last7.map((p) => <PlatformRow data={data} platform={p} />)}
      </div>
    )}
  </section>

  <section class="mt-6 space-y-3">
    <h2 class="text-sm font-semibold text-foreground flex items-center gap-2">
      8–30 天前 <Badge variant="outline" className={badgeTone('neutral')}>{last30.length}</Badge>
    </h2>
    {last30.length === 0 ? (
      <p class="text-xs text-muted-foreground py-4">暂无数据显示</p>
    ) : (
      <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
        {last30.map((p) => <PlatformRow data={data} platform={p} />)}
      </div>
    )}
  </section>
</SiteLayout>

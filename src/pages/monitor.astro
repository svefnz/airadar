---
import SiteLayout from '../layouts/SiteLayout.astro';
import { loadRadar } from "../lib/data/load";
import { Card, CardContent, CardHeader, CardTitle } from '../components/ui/card';
import { Badge } from '../components/ui/badge';
import { badgeTone } from '../lib/utils/badgeTone';
import { RUN_STATUS_LABELS } from '../lib/data/enums';
import { fmtDateTime, fmtTimeAgo } from '../lib/utils/format';
import { CheckCircle2, AlertTriangle, XCircle, Search, Clock3 } from 'lucide-react';

const data = loadRadar();
const lastRun = [...data.runs].sort((a, b) => Date.parse(b.startedAt) - Date.parse(a.startedAt))[0];
const successRuns = data.runs.filter((r) => r.status === 'success');
const lastSuccess = successRuns.sort((a, b) => Date.parse(b.completedAt ?? '') - Date.parse(a.completedAt ?? ''))[0];

const runTone = { success: 'ok', partial: 'warn', failed: 'bad' } as const;
const runIcon = { success: CheckCircle2, partial: AlertTriangle, failed: XCircle } as const;
---

<SiteLayout title="监控状态" description="ChatGPT 自动化监控运行状态">
  <div class="mb-5">
    <h1 class="text-xl font-bold">监控状态</h1>
    <p class="mt-1 text-xs text-muted">自动化任务每 3 小时执行一次免费额度监控与新平台发现，结果持久化到 GitHub 仓库。</p>
  </div>

  <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
    <div class="rounded-lg border border-edge bg-surface p-3.5">
      <div class="flex items-center gap-2 text-faint"><Clock3 class="h-4 w-4" /><span class="text-[11px] font-medium">计划监控间隔</span></div>
      <p class="mt-1.5 text-xl font-bold text-ink">3 小时</p>
    </div>
    <div class="rounded-lg border border-edge bg-surface p-3.5">
      <div class="flex items-center gap-2 text-faint"><CheckCircle2 class="h-4 w-4" /><span class="text-[11px] font-medium">最近成功执行</span></div>
      <p class="mt-1.5 text-xl font-bold text-ok">{lastSuccess?.completedAt ? fmtTimeAgo(lastSuccess.completedAt) : '尚无'}</p>
      <p class="text-[11px] text-faint">{lastSuccess?.completedAt ? fmtDateTime(lastSuccess.completedAt) : '—'}</p>
    </div>
    <div class="rounded-lg border border-edge bg-surface p-3.5">
      <div class="flex items-center gap-2 text-faint"><Search class="h-4 w-4" /><span class="text-[11px] font-medium">最近一次运行结果</span></div>
      <div class="mt-1.5">
        {lastRun ? (
          <Badge variant="outline" className={badgeTone(runTone[lastRun.status])}>{RUN_STATUS_LABELS[lastRun.status]}</Badge>
        ) : (
          <span class="text-sm text-faint">无运行记录</span>
        )}
      </div>
    </div>
    <div class="rounded-lg border border-edge bg-surface p-3.5">
      <div class="flex items-center gap-2 text-faint"><Clock3 class="h-4 w-4" /><span class="text-[11px] font-medium">GitHub 数据最后更新</span></div>
      <p class="mt-1.5 text-xl font-bold text-ink tabular">{data.lastSuccessfulSync ? fmtTimeAgo(data.lastSuccessfulSync) : '—'}</p>
      <p class="text-[11px] text-faint">{data.lastSuccessfulSync ? fmtDateTime(data.lastSuccessfulSync) : '尚未更新'}</p>
    </div>
  </div>

  {lastRun && (
    <div class="mt-4">
    <Card>
      <CardHeader>
        <CardTitle>最近一次执行详情</CardTitle>
        <Badge variant="outline" className={badgeTone(runTone[lastRun.status])}>{RUN_STATUS_LABELS[lastRun.status]}</Badge>
      </CardHeader>
      <CardContent className="px-4 pb-4">
        <div class="grid grid-cols-2 gap-y-3 gap-x-4 text-xs sm:grid-cols-3 lg:grid-cols-6">
          <div><p class="text-faint">开始时间</p><p class="mt-0.5 tabular text-ink">{fmtDateTime(lastRun.startedAt)}</p></div>
          <div><p class="text-faint">完成时间</p><p class="mt-0.5 tabular text-ink">{lastRun.completedAt ? fmtDateTime(lastRun.completedAt) : '—'}</p></div>
          <div><p class="text-faint">A 类活动搜索</p><p class="mt-0.5 font-medium text-ink">{lastRun.searchACompleted ? '已完成' : '未完成'}</p></div>
          <div><p class="text-faint">B 类新平台发现</p><p class="mt-0.5 font-medium text-ink">{lastRun.searchBCompleted ? '已完成' : '未完成'}</p></div>
          <div><p class="text-faint">检查来源数</p><p class="mt-0.5 tabular text-ink">{lastRun.sourcesChecked}</p></div>
          <div><p class="text-faint">待核实候选</p><p class="mt-0.5 tabular text-ink">{lastRun.candidatesFound}</p></div>
          <div><p class="text-faint">本轮新增资源</p><p class="mt-0.5 tabular text-ink">{lastRun.offersCreated}</p></div>
          <div><p class="text-faint">本轮更新资源</p><p class="mt-0.5 tabular text-ink">{lastRun.offersUpdated}</p></div>
          <div><p class="text-faint">标记过期</p><p class="mt-0.5 tabular text-ink">{lastRun.offersExpired}</p></div>
          <div><p class="text-faint">失败项</p><p class="mt-0.5 tabular text-bad">{lastRun.errors.length}</p></div>
          <div class="col-span-2 lg:col-span-2"><p class="text-faint">提交</p><p class="mt-0.5 tabular text-muted break-all">{lastRun.repositoryCommit ?? '—'}</p></div>
        </div>
        {lastRun.errors.length > 0 && (
          <div class="mt-3 rounded-md border border-bad/30 bg-bad-bg p-3">
            <p class="text-xs font-semibold text-bad">异常项</p>
            <ul class="mt-1 space-y-1 text-[11px] text-bad">
              {lastRun.errors.map((e, i) => (
                <li key={i}>[{e.code}] {e.message}{e.item ? `（${e.item}）` : ''}</li>
              ))}
            </ul>
          </div>
        )}
        {lastRun.note && <p class="mt-3 text-[11px] text-faint">{lastRun.note}</p>}
      </CardContent>
    </Card>
    </div>
  )}

  <div class="mt-4">
  <Card>
    <CardHeader>
      <CardTitle>运行历史（最近 {Math.min(data.runs.length, 12)} 条）</CardTitle>
    </CardHeader>
    <CardContent className="px-4 pb-4">
      <div class="overflow-x-auto">
        <table class="w-full text-xs">
          <thead>
            <tr class="border-b border-edge text-left text-faint">
              <th class="py-2 pr-3 font-medium">开始时间</th>
              <th class="py-2 pr-3 font-medium">结果</th>
              <th class="py-2 pr-3 font-medium">A/B</th>
              <th class="py-2 pr-3 font-medium text-right">来源</th>
              <th class="py-2 pr-3 font-medium text-right">新增</th>
              <th class="py-2 pr-3 font-medium text-right">更新</th>
              <th class="py-2 pr-3 font-medium text-right">过期</th>
              <th class="py-2 font-medium text-right">失败</th>
            </tr>
          </thead>
          <tbody>
            {[...data.runs].sort((a, b) => Date.parse(b.startedAt) - Date.parse(a.startedAt)).slice(0, 12).map((r) => {
              const Icon = runIcon[r.status];
              return (
                <tr key={r.id} class="border-b border-edge last:border-0">
                  <td class="py-2 pr-3 tabular text-ink">{fmtDateTime(r.startedAt)}</td>
                  <td class="py-2 pr-3">
                    <span class="inline-flex items-center gap-1 font-medium text-ink">
                      <Icon class={`h-3.5 w-3.5 ${r.status === 'success' ? 'text-ok' : r.status === 'failed' ? 'text-bad' : 'text-warn'}`} />
                      {RUN_STATUS_LABELS[r.status]}
                    </span>
                  </td>
                  <td class="py-2 pr-3 text-muted">{r.searchACompleted ? 'A✓' : 'A✗'} {r.searchBCompleted ? 'B✓' : 'B✗'}</td>
                  <td class="py-2 pr-3 text-right tabular text-ink">{r.sourcesChecked}</td>
                  <td class="py-2 pr-3 text-right tabular text-ink">{r.offersCreated}</td>
                  <td class="py-2 pr-3 text-right tabular text-ink">{r.offersUpdated}</td>
                  <td class="py-2 pr-3 text-right tabular text-ink">{r.offersExpired}</td>
                  <td class="py-2 text-right tabular text-bad">{r.errors.length}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
        {data.runs.length === 0 && <p class="py-6 text-center text-xs text-faint">暂无运行记录</p>}
      </div>
    </CardContent>
  </Card>
  </div>
</SiteLayout>

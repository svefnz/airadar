---
import SiteLayout from '../layouts/SiteLayout.astro';
import { ChangelogApp } from '../features/ChangelogApp';
import { loadRadar } from "../lib/data/load";

const data = loadRadar();
---

<SiteLayout title="变更记录" description="全局事件时间线">
  <div class="mb-5">
    <h1 class="text-xl font-bold">变更记录</h1>
    <p class="mt-1 text-xs text-muted">所有额度变化、延期、结束与状态变更，均可追溯原值/新值与证据来源</p>
  </div>
  <ChangelogApp data={data} client:load />
</SiteLayout>

---
import SiteLayout from '../layouts/SiteLayout.astro';
import { ResourcesApp } from '../features/ResourcesApp';
import { loadRadar } from "../lib/data/load";

const data = loadRadar();
---

<SiteLayout title="AI 免费资源雷达" description="实时追踪国内外大模型、Coding Agent 与平台免费额度与红利">
  <div class="mb-6 flex flex-col md:flex-row md:items-end justify-between gap-3 border-b border-[#182338] pb-5">
    <div>
      <div class="flex items-center gap-2">
        <span class="rounded-md bg-blue-600/20 border border-blue-500/40 px-2 py-0.5 text-[11px] font-semibold text-blue-400">
          ChatGPT 定时任务信源
        </span>
        <span class="text-xs text-slate-400">已收录 {data.platforms.length} 家平台</span>
      </div>
      <h1 class="mt-2 text-2xl font-black tracking-tight text-white sm:text-3xl">AI 免费额度与活动雷达</h1>
      <p class="mt-1.5 text-xs text-slate-400">持续核验全球主流 AI 模型 API、客户端免费试用与限时开发者权益 · 支持多维度筛选与卡片/表格视图切换</p>
    </div>
  </div>
  <ResourcesApp data={data} client:load />
</SiteLayout>

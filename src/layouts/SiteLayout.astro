---
import '../styles/global.css';
import { ThemeToggle, themeInitScript } from '../components/theme';
import { loadRadar } from "../lib/data/load";
import { PersonalDataPanel } from '../features/PersonalDataPanel';
import { MobileNav } from '../components/MobileNav';
import { SonnerMount } from '../components/SonnerMount';
import { withBase } from '../lib/utils/url';
import { ShieldAlert, Radio } from 'lucide-react';

interface Props {
  title: string;
  description?: string;
}

let demoCount = 0;
try {
  demoCount = loadRadar().offers.filter((o) => o.demo).length;
} catch {
  demoCount = 0;
}

const { title, description } = Astro.props;

const nav = [
  { href: '/', label: '总览', exact: true },
  { href: '/resources/', label: '资源库' },
  { href: '/discoveries/', label: '新平台发现' },
  { href: '/changelog/', label: '变更记录' },
  { href: '/monitor/', label: '监控状态' },
].map((item) => ({ ...item, href: withBase(item.href) }));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · AI Free Radar</title>
    <meta name="description" content={description ?? '持续更新的 AI 免费额度与新平台情报' } />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <script set:html={themeInitScript} />
  </head>
  <body class="min-h-screen">
    <div class="flex min-h-screen">
      <!-- 桌面端侧边导航 -->
      <aside class="sticky top-0 hidden h-screen w-52 shrink-0 flex-col border-r border-edge bg-surface lg:flex">
        <a href={withBase('/')} class="flex items-center gap-2 px-5 pt-5 pb-4">
          <span class="flex h-7 w-7 items-center justify-center rounded-md bg-accent text-accent-ink">
            <Radio class="h-4 w-4" />
          </span>
          <span class="text-sm font-bold tracking-tight">AI Free Radar</span>
        </a>
        <nav class="flex-1 px-3 space-y-0.5">
          {
            nav.map((item) => {
              const path = Astro.url.pathname;
              const active = item.exact ? path === item.href : path.startsWith(item.href);
              return (
                <a
                  href={item.href}
                  class:list={[
                    'block rounded-md px-3 py-2 text-[13px] font-medium transition-colors',
                    active ? 'bg-accent/10 text-accent' : 'text-muted hover:bg-elevated hover:text-ink',
                  ]}
                >
                  {item.label}
                </a>
              );
            })
          }
        </nav>
        <div class="border-t border-edge px-5 py-4">
          <p class="text-[11px] leading-4 text-faint">
            GitHub 仓库为唯一数据源
            <br />
            持续监控 · 永久历史
          </p>
        </div>
        <PersonalDataPanel client:load />
      </aside>

      <!-- 移动端顶部栏 -->
      <div class="fixed inset-x-0 top-0 z-40 flex h-12 items-center justify-between border-b border-edge bg-surface px-3 lg:hidden">
        <a href={withBase('/')} class="flex items-center gap-1.5">
          <span class="flex h-6 w-6 items-center justify-center rounded bg-accent text-accent-ink">
            <Radio class="h-3.5 w-3.5" />
          </span>
          <span class="text-sm font-bold">AI Free Radar</span>
        </a>
        <div class="flex items-center gap-1">
          <ThemeToggle client:load />
          <MobileNav client:load />
        </div>
      </div>

      <!-- 主内容 -->
      <div class="min-w-0 flex-1 pt-12 lg:pt-0">
        {
          demoCount > 0 && (
            <div class="flex items-center gap-2 border-b border-warn/30 bg-warn-bg px-4 py-2 text-xs text-warn">
              <ShieldAlert class="h-3.5 w-3.5 shrink-0" />
              <span>当前为演示数据（{demoCount} 项），正式监控写入后将自动替换。演示条目均标记「Demo」。</span>
            </div>
          )
        }
        <main class="mx-auto w-full max-w-6xl px-4 py-6 sm:px-6 lg:px-8">
          <slot />
        </main>
        <footer class="mx-auto max-w-6xl px-4 pb-8 text-center text-xs text-faint sm:px-6 lg:px-8">
          个人状态仅保存在当前浏览器（localStorage），不会自动同步其他设备 · 数据来自公开情报，使用前请自行核验官方条款
        </footer>
      </div>
    </div>

    <SonnerMount client:load />
  </body>
</html>

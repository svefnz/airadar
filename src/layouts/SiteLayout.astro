---
import '../styles/global.css';
import { themeInitScript } from '../components/theme';
import { loadRadar } from "../lib/data/load";
import { AppShell } from '../components/AppShell';
import { SonnerMount } from '../components/SonnerMount';
import { withBase } from '../lib/utils/url';

interface Props {
  title: string;
  description?: string;
}

let radarData;
let demoCount = 0;
try {
  radarData = loadRadar();
  demoCount = radarData.offers.filter((o) => o.demo).length;
} catch {
  demoCount = 0;
}

const { title, description } = Astro.props;
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · AI Free Radar</title>
    <meta name="description" content={description ?? '持续更新的 AI 免费额度与新平台情报' } />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <script set:html={themeInitScript} />
  </head>
  <body class="min-h-screen bg-[#080d1a]">
    <AppShell client:load pathname={Astro.url.pathname} demoCount={demoCount} data={radarData}>
      <slot />
    </AppShell>

    <SonnerMount client:load />
  </body>
</html>
